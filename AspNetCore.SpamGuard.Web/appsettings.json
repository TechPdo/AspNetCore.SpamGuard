{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SpamGuard": {
    // reCAPTCHA is optional in the demo. To enable it, set RecaptchaSiteKey here and store the secret with:
    //   dotnet user-secrets set "SpamGuard:RecaptchaSecretKey" "<secret>"
    // then set RequireRecaptcha to true.
    "RecaptchaSiteKey": "",
    "RecaptchaMinScore": 0.5,
    "RecaptchaExpectedAction": "submit",
    "RequireRecaptcha": false,
    "MinFormFillTimeSeconds": 2,
    "MaxFormFillTimeSeconds": 3600,
    "RequireFormToken": true,
    "RandomTextCheckFields": [
      "name",
      "message"
    ],
    "RandomTextThreshold": 1,
    "EnableRateLimit": true,
    "RateLimitWindowMinutes": 10,
    "RateLimitMaxSubmissions": 3,
    "SpamConfidenceThreshold": 0.7,
    "SpamKeywords": [
      "casino",
      "lottery"
    ],
    "SpamDatabase": {
      "Enabled": false,
      "MinConfidence": 50
    }
  }
}
