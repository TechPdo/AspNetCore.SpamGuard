<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Our.AspNetCore.SpamGuard</PackageId>
    <Product>Our.AspNetCore.SpamGuard</Product>
    <Title>AspNetCore SpamGuard</Title>
    <Version>2.0.0</Version>
    <Authors>Pasang Tamang</Authors>
    <Company>Pasang Tamang</Company>
    <Description>A comprehensive, multi-layered spam protection library for ASP.NET Core applications with reCAPTCHA v3 integration, honeypot fields, signed timing tokens, StopForumSpam lookups, rate limiting and pattern detection.</Description>
    <PackageTags>aspnetcore;spam;protection;recaptcha;security;antispam;honeypot;stopforumspam</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TechPdo/AspNetCore.SpamGuard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TechPdo/AspNetCore.SpamGuard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>$([System.DateTime]::Now.Year) © $(Authors)</Copyright>
    <PackageReleaseNotes>
2.0.0 (breaking changes; see "Upgrading from 1.x" in the README)
- SpamDatabaseRule is now an opt-in StopForumSpam lookup (public IPs and MD5 email hashes only, cached, fail-open).
- Scoring uses noisy-OR, so every triggered rule raises the score.
- Configured lists replace the defaults instead of being appended to them.
- Options are validated at startup; AddSpamGuard returns ISpamGuardBuilder.
- Thread-safe rate limiting (IPv6 grouped per /64), ReDoS-safe and Unicode-aware random text detection, whole-word keywords.
- New: signed form token, &lt;spam-guard-fields /&gt; tag helper, HttpContext context builders, DisabledRules and FailedRules.
- Uses the shared ASP.NET Core framework instead of the deprecated Microsoft.AspNetCore.Http.Abstractions 2.x package.
    </PackageReleaseNotes>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
</Project>
